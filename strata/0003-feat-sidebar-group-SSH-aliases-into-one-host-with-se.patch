+pub(super) fn select_route(group: &str, route: &str) -> std::io::Result<()> {
+    let mut settings = Settings::load();
+    let Some(entry) = settings.groups.get_mut(group) else {
+        return Ok(());
+    };
+    entry.selected = Some(route.to_owned());
+    settings.save()
+}
