+
+/// Applies hiding, route groups, and overrides. A group takes the place of its
+/// first route alias in config order and hides its other routes.
+pub(super) fn arrange(hosts: Vec<SshHost>, mut settings: Settings) -> Vec<SshHost> {
+    let mut placed = Vec::new();
+    let mut result = Vec::new();
+    for host in &hosts {
+        let group = settings
+            .groups
+            .iter()
+            .find(|(_, group)| group.routes.values().any(|alias| *alias == host.alias));
+        let mut entry = match group {
+            Some((name, _)) if placed.contains(name) => continue,
+            Some((name, group)) => {
+                placed.push(name.clone());
+                let available: Vec<_> = group
+                    .routes
+                    .iter()
+                    .filter(|(_, alias)| hosts.iter().any(|host| host.alias == **alias))
+                    .collect();
+                let Some(&(first, _)) = available.first() else {
+                    continue;
+                };
+                let selected = group
+                    .selected
+                    .as_ref()
+                    .filter(|route| available.iter().any(|(name, _)| name == route))
+                    .unwrap_or(first);
+                let alias = &group.routes[selected];
+                let Some(target) = hosts.iter().find(|host| host.alias == *alias) else {
+                    continue;
+                };
+                SshHost {
+                    group: Some(name.clone()),
+                    route: Some(RouteChoice {
+                        routes: available.iter().map(|(name, _)| (*name).clone()).collect(),
+                        selected: selected.clone(),
+                    }),
+                    ..target.clone()
+                }
             }
-            host
-        })
-        .collect()
+            None if settings.hidden.contains(&host.alias) => continue,
+            None => host.clone(),
+        };
+        if let Some(custom) = settings.hosts.remove(entry.key()) {
+            entry.custom = custom;
+        }
+        result.push(entry);
+    }
+    result
 }
 
