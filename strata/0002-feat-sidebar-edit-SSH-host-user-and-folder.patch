+#[test]
+fn overrides_change_user_folder_and_uri() {
+    let mut host = parse_config("Host deid.tail.ts.net\nUser noah\n").remove(0);
+    assert_eq!(host.display_name(), "noah@deid");
+
+    host.custom.user = Some("eicon".to_owned());
+    assert_eq!(host.display_name(), "eicon@deid");
+    assert_eq!(
+        host.location(),
+        Location::uri("sftp://eicon@deid.tail.ts.net/home/eicon")
+    );
+
+    host.custom.folder = Some("~/my projects".to_owned());
+    assert_eq!(
+        host.location(),
+        Location::uri("sftp://eicon@deid.tail.ts.net/home/eicon/my%20projects")
+    );
+
+    host.custom = HostOverride {
+        user: None,
+        folder: Some("/mnt/data".to_owned()),
