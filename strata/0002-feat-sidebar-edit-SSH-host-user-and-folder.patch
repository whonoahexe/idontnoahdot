+// SPDX-License-Identifier: MIT
+
+use std::rc::Rc;
+
+use gtk::{glib, prelude::*};
+
+use crate::{
+    assets,
+    ui::{controls::form_entry, modal::dismiss_modal_layer},
+};
+
+use super::{
+    super::{device_release, ssh_hosts},
+    field_block, inline_error, modal_shell, show_inline_error, wire_entry_submission,
+    wire_modal_close_except_confirm,
+};
+
+pub(in crate::ui::window) fn show_ssh_host_dialog(parent: &gtk::Widget, host: &ssh_hosts::SshHost) {
+    let Some(shell) = modal_shell(
+        parent,
+        assets::icons::TERMINAL,
+        "Edit connection",
+        &host.alias,
+        "Save",
+        false,
+    ) else {
+        return;
+    };
+    shell.layout.content.set_width_request(480);
+
+    let user = form_entry();
+    user.set_placeholder_text(Some(&host.default_user()));
+    user.set_text(host.custom.user.as_deref().unwrap_or_default());
+    let folder = form_entry();
+    folder.set_text(host.custom.folder.as_deref().unwrap_or_default());
+    shell.layout.body.append(&field_block("User", &user));
+    shell.layout.body.append(&field_block("Folder", &folder));
+    let hint = gtk::Label::new(Some(
+        "Leave a field blank to use the default: the user from ~/.ssh/config and their home folder.",
+    ));
+    hint.add_css_class("dim-label");
+    hint.set_max_width_chars(40);
+    hint.set_xalign(0.0);
+    hint.set_wrap(true);
+    shell.layout.body.append(&hint);
+    let error = inline_error();
+    error.set_max_width_chars(26);
+    error.set_hexpand(true);
+    shell.layout.actions.prepend(&error);
+
+    let confirm = shell.layout.confirm.clone();
+    let default_user = host.default_user();
+    let validate: Rc<dyn Fn()> = {
+        let (user, folder, confirm, error) = (
+            user.downgrade(),
+            folder.downgrade(),
+            confirm.downgrade(),
+            error.downgrade(),
+        );
+        Rc::new(move || {
+            let (Some(user), Some(folder), Some(confirm), Some(error)) = (
+                user.upgrade(),
+                folder.upgrade(),
+                confirm.upgrade(),
+                error.upgrade(),
+            ) else {
+                return;
+            };
+            let user_text = user.text();
+            let name = if user_text.trim().is_empty() {
+                default_user.clone()
+            } else {
+                user_text.trim().to_owned()
+            };
+            folder.set_placeholder_text(Some(&ssh_hosts::home_folder(&name)));
+            let problem = ssh_hosts::user_error(user_text.trim())
+                .or_else(|| ssh_hosts::folder_error(folder.text().trim()));
+            match problem {
+                Some(message) => show_inline_error(&error, message),
+                None => error.set_visible(false),
+            }
+            confirm.set_sensitive(problem.is_none());
+        })
+    };
+    validate();
+    for entry in [&user, &folder] {
+        let validate = validate.clone();
+        entry.connect_changed(move |_| validate());
+        wire_entry_submission(entry, &confirm);
+    }
+
+    let layer = shell.layer.clone();
+    let overlay = shell.overlay.clone();
+    let root = shell.blurred_root.clone();
+    let alias = host.alias.clone();
+    let (user_entry, folder_entry, error_label) = (user.clone(), folder.clone(), error.clone());
+    shell.layout.confirm.connect_clicked(move |button| {
+        if !button.is_sensitive() {
+            return;
+        }
+        let non_empty = |text: glib::GString| {
+            let text = text.trim();
+            (!text.is_empty()).then(|| text.to_owned())
+        };
+        let value = ssh_hosts::HostOverride {
+            user: non_empty(user_entry.text()),
+            folder: non_empty(folder_entry.text()),
+        };
+        match ssh_hosts::save_override(&alias, value) {
+            Ok(()) => {
+                dismiss_modal_layer(&layer, &overlay, root.as_ref());
+                device_release::refresh_sidebars();
+            }
+            Err(error) => show_inline_error(&error_label, &format!("Could not save: {error}")),
+        }
+    });
+    wire_modal_close_except_confirm(&shell);
+    user.grab_focus();
+}
