+#[derive(Clone, Debug, Default, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub(super) struct HostOverride {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub user: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub folder: Option<String>,
+}
+
+#[derive(Debug, Default, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Settings {
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub hidden: Vec<String>,
+    #[serde(default, skip_serializing_if = "BTreeMap::is_empty")]
+    pub hosts: BTreeMap<String, HostOverride>,
+}
+
+fn settings_path() -> PathBuf {
+    glib::user_config_dir().join("strata/ssh-hosts.toml")
+}
+
+impl Settings {
+    pub(super) fn load() -> Self {
+        let Ok(contents) = std::fs::read_to_string(settings_path()) else {
+            return Self::default();
+        };
+        toml::from_str(&contents).unwrap_or_else(|error| {
+            tracing::warn!("could not parse ssh-hosts.toml: {error}");
+            Self::default()
+        })
+    }
+
+    fn save(&self) -> std::io::Result<()> {
+        let path = settings_path();
+        if let Some(parent) = path.parent() {
+            std::fs::create_dir_all(parent)?;
+        }
+        let contents = toml::to_string(self).map_err(std::io::Error::other)?;
+        let temp = path.with_extension("toml.tmp");
+        std::fs::write(&temp, contents)?;
+        std::fs::rename(temp, path)
+    }
+}
+
+pub(super) fn save_override(alias: &str, value: HostOverride) -> std::io::Result<()> {
+    let mut settings = Settings::load();
+    if value == HostOverride::default() {
+        settings.hosts.remove(alias);
+    } else {
+        settings.hosts.insert(alias.to_owned(), value);
+    }
+    settings.save()
+}
