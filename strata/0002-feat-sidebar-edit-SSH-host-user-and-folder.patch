-        Location::uri(format!("sftp://{}{home}", self.alias))
+        let path = glib::Uri::escape_string(&self.folder(), Some("/"), true);
+        Location::uri(format!("sftp://{authority}{path}"))
+    }
+}
+
+pub(super) fn home_folder(user: &str) -> String {
+    if user == "root" {
+        "/root".to_owned()
+    } else {
+        format!("/home/{user}")
+    }
+}
+
+pub(super) fn expand_folder(folder: &str, home: &str) -> String {
+    match folder.strip_prefix('~') {
+        Some("") => home.to_owned(),
+        Some(rest) if rest.starts_with('/') => format!("{home}{rest}"),
+        _ => folder.to_owned(),
+    }
+}
+
+pub(super) fn user_error(user: &str) -> Option<&'static str> {
+    if user.is_empty() {
+        return None;
     }
+    let valid = user
+        .chars()
+        .all(|c| c.is_ascii_alphanumeric() || matches!(c, '.' | '_' | '-'));
+    (!valid).then_some("Use only letters, digits, dots, dashes, and underscores.")
+}
+
+pub(super) fn folder_error(folder: &str) -> Option<&'static str> {
+    if folder.is_empty() || folder.starts_with('/') || folder == "~" || folder.starts_with("~/") {
+        return None;
+    }
+    Some("Start the folder with / or ~/.")
 }
 
