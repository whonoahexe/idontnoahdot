+#[test]
+fn settings_round_trip_and_reject_unknown_keys() {
+    let text = "hidden = [\"studio-ext\"]\n\n[hosts.deid]\nuser = \"eicon\"\n";
+    let settings: Settings = toml::from_str(text).unwrap();
+    assert_eq!(settings.hidden, ["studio-ext"]);
+    assert_eq!(settings.hosts["deid"].user.as_deref(), Some("eicon"));
+    assert_eq!(
+        toml::from_str::<Settings>(&toml::to_string(&settings).unwrap())
+            .unwrap()
+            .hosts,
+        settings.hosts
+    );
+    assert!(toml::from_str::<Settings>("[hosts.deid]\nport = 2\n").is_err());
