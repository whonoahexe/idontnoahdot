index 00000000..109cebd1
--- /dev/null
+++ b/src/ui/window/ssh_hosts/tests.rs
@@ -0,0 +1,36 @@
+use super::*;
+
+#[test]
+fn parses_hosts_users_and_skips_patterns() {
+    let config = "Host studio\r\n    HostName 192.168.1.10\r\n    User alice\r\n\
+                  Host *.example a?b !neg\n  User nobody\n\
+                  Host box.tail.ts.net\n  User=root\n\
+                  Host bare\n\
+                  Match host bare\n  User ignored\n";
+    let hosts = parse_config(config);
+    let summary: Vec<_> = hosts
+        .iter()
+        .map(|host| (host.alias.as_str(), host.user.as_deref(), host.label()))
+        .collect();
+    assert_eq!(
+        summary,
+        [
+            ("studio", Some("alice"), "studio"),
+            ("box.tail.ts.net", Some("root"), "box"),
+            ("bare", None, "bare"),
+        ]
+    );
+    assert_eq!(
+        hosts[0].location(),
+        Location::uri("sftp://studio/home/alice")
+    );
+    assert_eq!(hosts[1].location(), Location::uri("sftp://box.tail.ts.net/root"));
+}
+
+#[test]
+fn first_user_wins_and_ip_labels_stay_whole() {
+    let hosts = parse_config("Host 10.0.0.5\nUser a\nHost 10.0.0.5\nUser b\n");
+    assert_eq!(hosts.len(), 1);
+    assert_eq!(hosts[0].user.as_deref(), Some("a"));
+    assert_eq!(hosts[0].label(), "10.0.0.5");
+}
