+++ b/src/ui/window/ssh_hosts.rs
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: MIT
+
+//! SSH hosts from `~/.ssh/config`, listed under Network in the sidebar.
+
+use std::{cell::Cell, path::Path};
+
+use gtk::glib;
+
+use crate::model::Location;
+
+thread_local! {
+    static EXPANDED: Cell<bool> = const { Cell::new(false) };
+}
+
+pub(super) fn expanded() -> bool {
+    EXPANDED.with(Cell::get)
+}
+
+pub(super) fn toggle_expanded() {
+    EXPANDED.with(|expanded| expanded.set(!expanded.get()));
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) struct SshHost {
+    pub alias: String,
+    pub user: Option<String>,
+}
+
+impl SshHost {
+    pub(super) fn label(&self) -> &str {
+        if self.alias.parse::<std::net::IpAddr>().is_ok() {
+            return &self.alias;
+        }
+        self.alias.split('.').next().unwrap_or(&self.alias)
+    }
+
+    /// The URI carries no user so ssh still applies the config's User, keys, and ProxyJump.
+    pub(super) fn location(&self) -> Location {
+        let user = self
+            .user
+            .clone()
+            .unwrap_or_else(|| glib::user_name().to_string_lossy().into_owned());
+        let home = if user == "root" {
+            "/root".to_owned()
+        } else {
+            format!("/home/{user}")
+        };
+        Location::uri(format!("sftp://{}{home}", self.alias))
+    }
+}
+
+pub(super) fn load() -> Vec<SshHost> {
+    let config = std::fs::read_to_string(glib::home_dir().join(".ssh/config")).unwrap_or_default();
+    let hidden = read_hidden(&glib::user_config_dir().join("strata/ssh-hosts-hidden"));
+    parse_config(&config)
+        .into_iter()
+        .filter(|host| !hidden.contains(&host.alias))
+        .collect()
+}
+
+fn read_hidden(path: &Path) -> Vec<String> {
+    std::fs::read_to_string(path)
+        .unwrap_or_default()
+        .lines()
+        .map(str::trim)
+        .filter(|line| !line.is_empty() && !line.starts_with('#'))
+        .map(str::to_owned)
+        .collect()
+}
+
+pub(super) fn parse_config(config: &str) -> Vec<SshHost> {
+    let mut hosts: Vec<SshHost> = Vec::new();
+    let mut block: Vec<usize> = Vec::new();
+    for line in config.lines() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        let (keyword, value) = match line.split_once(|c: char| c.is_whitespace() || c == '=') {
+            Some((keyword, value)) => (keyword, value.trim_start_matches(['=', ' ', '\t']).trim()),
+            None => (line, ""),
+        };
+        if keyword.eq_ignore_ascii_case("host") {
+            block.clear();
+            for alias in value.split_whitespace() {
+                if alias.contains(['*', '?', '!']) {
+                    continue;
+                }
+                let index = match hosts.iter().position(|host| host.alias == alias) {
+                    Some(index) => index,
+                    None => {
+                        hosts.push(SshHost {
+                            alias: alias.to_owned(),
+                            user: None,
+                        });
+                        hosts.len() - 1
+                    }
+                };
+                block.push(index);
+            }
+        } else if keyword.eq_ignore_ascii_case("match") {
+            block.clear();
+        } else if keyword.eq_ignore_ascii_case("user") && !value.is_empty() {
+            for &index in &block {
+                hosts[index].user.get_or_insert_with(|| value.to_owned());
+            }
+        }
+    }
+    hosts
+}
+
+#[cfg(test)]
+mod tests;
