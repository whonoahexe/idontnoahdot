@@ -60,22 +59,27 @@ Singleton {
     property bool rec: false
     readonly property bool night: Rules.store.night
     property bool air: false
-    // noah: WARP for the vpn tile, polled too since warp-cli or end4's sidebar can flip it
+    // noah: tunnels for the vpn tile and panel (vpn/), polled too since warp-cli, protonvpn or end4's sidebar can flip them.
+    // proton — по интерфейсу: protonvpn status — питон, полсекунды CPU
     property bool vpn: false
+    property bool proton: false
     Process {
         id: poll
         command: ["sh", "-c", "pgrep -f '^gpu-screen-recorder' >/dev/null && echo rec; "
                             + "rfkill -rno SOFT | grep -qv '^blocked' || echo air; "
-                            + "warp-cli --accept-tos status 2>/dev/null | grep -q 'Status update: Connected' && echo warp"]
+                            + "warp-cli --accept-tos status 2>/dev/null | grep -q 'Status update: Connected' && echo warp; "
+                            + "[ -e /sys/class/net/proton0 ] && echo proton"]
         stdout: StdioCollector {
             onStreamFinished: {
                 root.rec = text.includes("rec");
                 root.air = text.includes("air");
                 root.vpn = text.includes("warp");
+                root.proton = text.includes("proton");
             }
         }
     }
     Timer { running: true; repeat: true; interval: 3000; triggeredOnStart: true; onTriggered: poll.running = true }
+    function repoll() { poll.running = true; } // noah: vpn/ after its own connect/disconnect
 
     function sh(c) { Quickshell.execDetached(["sh", "-c", c]); }
     // настройки записи из Theme.state (quick/Rec) → флаги gpu-screen-recorder; их же берёт скриншотилка
@@ -132,7 +136,9 @@ Singleton {
         }
     }
 
-    // ---- vpn: noah: the Quick tile drives Cloudflare WARP (state in the poll above); verge stays for the vpn/ panel (Super+P) ----
-    readonly property var verge: SystemTray.items.values.find(i => i.title === "clash-verge" || i.id.includes("clash-verge")) ?? null
-    function toggleVpn() { Quickshell.execDetached(["warp-cli", "--accept-tos", vpn ? "disconnect" : "connect"]); vpn = !vpn; }
+    // ---- vpn: noah: the Quick tile drives Cloudflare WARP (state in the poll above); Proton is dropped first, two tunnels fight ----
+    function toggleVpn() {
+        sh(vpn ? "warp-cli --accept-tos disconnect" : `${proton ? "protonvpn disconnect >/dev/null 2>&1; " : ""}warp-cli --accept-tos connect`);
+        vpn = !vpn;
+    }
 }
