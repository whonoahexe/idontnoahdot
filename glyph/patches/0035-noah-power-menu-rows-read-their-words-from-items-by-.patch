From: noah <whonoah.exe@gmail.com>
Date: Fri, 30 Oct 2026 13:46:52 +0530
Subject: [PATCH] =?UTF-8?q?noah:=20power=20menu=20rows=20read=20their=20wo?=
 =?UTF-8?q?rds=20from=20items=20by=20index=20=E2=80=94=20Repeater=20mangle?=
 =?UTF-8?q?d=20the=20[label,=20fn]=20pairs=20into=20"T"=20and=20a=20missin?=
 =?UTF-8?q?g=20glyph;=20fit()=20without=20side=20effects=20(FontMetrics)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 config/quickshell/glyph/power/Power.qml | 24 ++++++++++++------------
 1 file changed, 12 insertions(+), 12 deletions(-)

diff --git a/config/quickshell/glyph/power/Power.qml b/config/quickshell/glyph/power/Power.qml
index 3b88a7d..9d0fdd2 100644
--- a/config/quickshell/glyph/power/Power.qml
+++ b/config/quickshell/glyph/power/Power.qml
@@ -27,12 +27,10 @@ PanelWindow {
     readonly property bool paired: Array.isArray(items[sel][0])
     // noah: at 168 a paired row would run into the uptime ring, so its chosen half grows only as far as fits
     // (900 = from the words to the ring with a margin; the other half and the slash stay at 66)
-    TextMetrics { id: big; font { family: Theme.dot; pixelSize: 168; weight: Font.Black } }
-    TextMetrics { id: small; font { family: Theme.dot; pixelSize: 66; weight: Font.Black } }
+    FontMetrics { id: dots; font { family: Theme.dot; pixelSize: 168; weight: Font.Black } }
     function fit(row, half) {
-        big.text = row[half][0];
-        small.text = row[1 - half][0] + "/";
-        return Math.min(168, Math.floor(168 * (900 - small.width - 60) / big.width));
+        const other = dots.advanceWidth(row[1 - half][0] + "/") * 66 / 168;
+        return Math.min(168, Math.floor(168 * (900 - other - 60) / dots.advanceWidth(row[half][0])));
     }
 
     function open() {
@@ -80,11 +78,14 @@ PanelWindow {
             anchors.verticalCenter: parent.verticalCenter
             spacing: 26
             Repeater {
-                model: root.items
+                // noah: models are counts and the words are read from root.items: Repeater mangled the [label, fn] pairs
+                // when handed them as model data (the paired row came out as "T" and a missing glyph)
+                model: root.items.length
                 Row {
                     id: it
-                    required property var modelData
                     required property int index
+                    readonly property var row: root.items[index]
+                    readonly property bool pair: Array.isArray(row[0])
                     readonly property bool on: root.sel === index
                     spacing: 30
                     Rectangle {
@@ -99,13 +100,12 @@ PanelWindow {
                     Row {
                         spacing: 20
                         Repeater {
-                            model: Array.isArray(it.modelData[0]) ? it.modelData : [it.modelData]
+                            model: it.pair ? 2 : 1
                             Row {
                                 id: half
                                 anchors.bottom: parent.bottom
-                                required property var modelData
                                 required property int index
-                                readonly property bool lit: it.on && (!Array.isArray(it.modelData[0]) || root.side === index)
+                                readonly property bool lit: it.on && (!it.pair || root.side === index)
                                 spacing: 20
                                 Num {
                                     anchors.baseline: word.baseline
@@ -116,8 +116,8 @@ PanelWindow {
                                 }
                                 Num {
                                     id: word
-                                    text: half.modelData[0]
-                                    font.pixelSize: !half.lit ? 66 : Array.isArray(it.modelData[0]) ? root.fit(it.modelData, half.index) : 168
+                                    text: (it.pair ? it.row[half.index] : it.row)[0]
+                                    font.pixelSize: !half.lit ? 66 : it.pair ? root.fit(it.row, half.index) : 168
                                     color: half.lit ? Theme.fg : Theme.mute
                                     Behavior on font.pixelSize { NumberAnimation { duration: Theme.t; easing.type: Easing.BezierSpline; easing.bezierCurve: Theme.glide } }
                                     Behavior on color { ColorAnimation { duration: Theme.t } }
-- 
