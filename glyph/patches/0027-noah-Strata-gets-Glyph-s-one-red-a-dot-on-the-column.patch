---
 config/quickshell/glyph/term/gtk-4.0/gtk.css | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/config/quickshell/glyph/term/gtk-4.0/gtk.css b/config/quickshell/glyph/term/gtk-4.0/gtk.css
index 9bbc65d..fcf9f83 100644
--- a/config/quickshell/glyph/term/gtk-4.0/gtk.css
+++ b/config/quickshell/glyph/term/gtk-4.0/gtk.css
@@ -85,3 +85,10 @@ headerbar button.header-action, headerbar menubutton.header-action > button { bo
 .preview-table-interactive > scrolledwindow > viewport { background: transparent; }
 .preview-title { font-family: "Space Grotesk", sans-serif; }
 .preview-metadata, .preview-metadata * { font-family: "Space Mono", monospace; letter-spacing: 0.08em; }
+/* the one red thing, as in the shell: a dot on the column that owns the keys (the wallpaper picker's "live now" dot),
+   the caret in Strata's own fields, and the fill of a copy/move that's running */
+.column-heading { padding-left: 14px; background-repeat: no-repeat; background-position: 2px center; background-size: 6px 6px; }
+.directory-column:focus-within .column-heading { background-image: radial-gradient(circle closest-side, #D71921 85%, alpha(#D71921, 0) 100%); }
+.location-entry, .location-entry text, .inline-rename, .inline-rename text, .column-filter-entry, .column-filter-entry text,
+.search-field, .search-field text, .preview-command-entry, .preview-command-entry text { caret-color: #D71921; }
+.modal-progress progress, .job-progress progress { background: #D71921; }
