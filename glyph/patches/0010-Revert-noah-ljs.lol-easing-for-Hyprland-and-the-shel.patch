diff --git a/config/hypr/hyprland/animations.lua b/config/hypr/hyprland/animations.lua
index 2759e78..5ca55fe 100644
--- a/config/hypr/hyprland/animations.lua
+++ b/config/hypr/hyprland/animations.lua
@@ -5,14 +5,10 @@ hl.config({
 })
 
 -- Animation curves
--- noah: curves from ljs.lol, same names so every animation (and user.lua's window overrides)
--- picks them up. Opens/closes use its ease-out click ripple: its in-out story curves felt laggy
--- for things you wait on. Moves, workspaces and fades keep the in-out ones. Toggle: glyph-easing off|on
---   was specialWorkSwitch/emphasizedDecel {0.05,0.7},{0.1,1}; emphasizedAccel {0.3,0},{0.8,0.15}; standard {0.2,0},{0,1}
-hl.curve("specialWorkSwitch", { type = "bezier", points = { { 0.65, 0.04 }, { 0.5, 1 } } })  -- ljs soft landing
-hl.curve("emphasizedAccel", { type = "bezier", points = { { 0.22, 1 }, { 0.36, 1 } } })      -- ljs click ripple (ease-out): closes
-hl.curve("emphasizedDecel", { type = "bezier", points = { { 0.22, 1 }, { 0.36, 1 } } })      -- ljs click ripple (ease-out): opens
-hl.curve("standard", { type = "bezier", points = { { 0.5, 0 }, { 0.5, 1 } } })               -- ljs symmetric ease-in-out
+hl.curve("specialWorkSwitch", { type = "bezier", points = { { 0.05, 0.7 }, { 0.1, 1 } } })
+hl.curve("emphasizedAccel", { type = "bezier", points = { { 0.3, 0 }, { 0.8, 0.15 } } })
+hl.curve("emphasizedDecel", { type = "bezier", points = { { 0.05, 0.7 }, { 0.1, 1 } } })
+hl.curve("standard", { type = "bezier", points = { { 0.2, 0 }, { 0, 1 } } })
 
 -- Animation configs
 hl.animation({ leaf = "layersIn", enabled = true, speed = 5, bezier = "emphasizedDecel", style = "slide" })
diff --git a/config/quickshell/glyph/Theme.qml b/config/quickshell/glyph/Theme.qml
index 27c02de..25df55d 100644
--- a/config/quickshell/glyph/Theme.qml
+++ b/config/quickshell/glyph/Theme.qml
@@ -37,14 +37,8 @@ Singleton {
         return sc ? Math.min(sc.width / 1920, sc.height / 1080) : 1;
     }
 
-    // noah: easing from ljs.lol (its Theatre.js keyframes). Revert: git revert ljs-easing
-    readonly property var ljsInOut: [0.5, 0, 0.5, 1, 1, 1]      // symmetric ease-in-out (Theatre default)
-    readonly property var ljsCubic: [0.65, 0.04, 0.35, 1, 1, 1] // ~easeInOutCubic, their main curve
-    readonly property var ljsSoft: [0.65, 0.04, 0.5, 1, 1, 1]   // same start, softer landing
-    readonly property var ljsRipple: [0.22, 1, 0.36, 1, 1, 1]   // their click ripple: ease-out, for things that open/close
-    // glide: was ease-out-quart [0.25, 1, 0.5, 1], без перелёта — как bezier glide в hypr.
-    // Opens/closes need an ease-out to feel instant, so the ripple, not the in-out story curves
-    readonly property var glide: ljsRipple
+    // glide: ease-out-quart, без перелёта — как bezier glide в hypr
+    readonly property var glide: [0.25, 1, 0.5, 1, 1, 1]
     readonly property int t: 350
 
     // обои рисуются из копии под экран (её делает пикер, magick): оригинал бывает png на 40 МБ, грузился бы секунды.
