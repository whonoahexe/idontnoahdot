From bb09015e89b8b4735921e7aaef47cb3e309c6c99 Mon Sep 17 00:00:00 2001
From: noah <whonoah.exe@gmail.com>
Date: Tue, 27 Oct 2026 16:14:31 +0530
Subject: [PATCH 19/24] noah: wallpaper picker gets HOME (default / clear:
 shades behind the clock and greeting) and MOTION (still / live) options; the
 live scene follows the LIGHT dial

---
 config/quickshell/glyph/Theme.qml      |  1 +
 config/quickshell/glyph/home/Back.qml  | 39 ++++++++++++++++++++++++++
 config/quickshell/glyph/wall/Walls.qml | 22 +++++++++++++++
 3 files changed, 62 insertions(+)

diff --git a/config/quickshell/glyph/Theme.qml b/config/quickshell/glyph/Theme.qml
index f253759..1c7fd01 100644
--- a/config/quickshell/glyph/Theme.qml
+++ b/config/quickshell/glyph/Theme.qml
@@ -96,6 +96,7 @@ Singleton {
             property int recFps: 60
             property int recQuality: 2     // medium, high, very_high, ultra
             property bool recCursor: true
+            property int homeUi: 0          // noah: home over a wallpaper: 0 default, 1 clear (shade behind the clock, greeting, edges)
             property bool wallLive: true   // noah: a wallpaper folder's scene/Scene.qml plays over it (look: color)
             property string vpnLast: "warp" // noah: vpn/ ring brings back the last tunnel used: warp | proton
             property bool clipRaw: false   // noah: clip/ image preview in original colours instead of dots (Ctrl+O / click)
diff --git a/config/quickshell/glyph/home/Back.qml b/config/quickshell/glyph/home/Back.qml
index a3a314a..7b2d051 100644
--- a/config/quickshell/glyph/home/Back.qml
+++ b/config/quickshell/glyph/home/Back.qml
@@ -51,4 +51,43 @@ PanelWindow {
         opacity: status === Loader.Ready ? 1 : 0
         Behavior on opacity { NumberAnimation { duration: 600 } }
     }
+    // the scene draws the picture itself, past the wall shader's LIGHT: dim it the same way, towards the background
+    Rectangle {
+        anchors.fill: parent
+        visible: root.sceneOk
+        color: Theme.bg
+        opacity: (1 - Theme.state.wallBright / 100) * (Sys.wallOpen ? 0 : 1)
+    }
+
+    // noah: clear home — the picker's top and bottom shades, plus one behind the clock and greeting on the left
+    Stage {
+        visible: Theme.state.homeUi === 1 && !!Theme.state.wall
+        Rectangle {
+            width: parent.width
+            height: 380
+            gradient: Gradient {
+                GradientStop { position: 0; color: Theme.fade(Theme.bg, 0.8) }
+                GradientStop { position: 1; color: Theme.fade(Theme.bg, 0) }
+            }
+        }
+        Rectangle {
+            y: parent.height - height
+            width: parent.width
+            height: 460
+            gradient: Gradient {
+                GradientStop { position: 0; color: Theme.fade(Theme.bg, 0) }
+                GradientStop { position: 1; color: Theme.fade(Theme.bg, 0.85) }
+            }
+        }
+        Rectangle {
+            width: 1300
+            height: parent.height
+            gradient: Gradient {
+                orientation: Gradient.Horizontal
+                GradientStop { position: 0; color: Theme.fade(Theme.bg, 0.75) }
+                GradientStop { position: 0.55; color: Theme.fade(Theme.bg, 0.45) }
+                GradientStop { position: 1; color: Theme.fade(Theme.bg, 0) }
+            }
+        }
+    }
 }
diff --git a/config/quickshell/glyph/wall/Walls.qml b/config/quickshell/glyph/wall/Walls.qml
index 260d106..e7cbf04 100644
--- a/config/quickshell/glyph/wall/Walls.qml
+++ b/config/quickshell/glyph/wall/Walls.qml
@@ -31,6 +31,10 @@ PanelWindow {
     property int look: 0
     property int pitch: 10
     property int bright: 85
+    property int ui: 0        // noah: home over the wallpaper: default / clear
+    property bool live: true  // noah: play the folder's scene/Scene.qml on home (colour look)
+    readonly property bool hasScene: !!view && sceneF.loaded
+    FileView { id: sceneF; path: root.view ? root.view.slice(0, root.view.lastIndexOf("/")) + "/scene/Scene.qml" : ""; printErrors: false }
 
     function name(p) { return p ? p.slice(p.lastIndexOf("/") + 1).replace(/\.[^.]+$/, "") : "nothing"; }
     function go(d) { pick = list[Math.max(0, Math.min(list.length - 1, sel + d))]; }
@@ -69,6 +73,8 @@ PanelWindow {
         look = s.wallLook;
         pitch = s.wallPitch;
         bright = s.wallBright;
+        ui = s.homeUi;
+        live = s.wallLive;
         if (!scan.running) {
             fresh = [];
             scan.running = true;
@@ -82,6 +88,8 @@ PanelWindow {
         const s = Theme.state;
         s.wall = pick;
         s.wallLook = look;
+        s.homeUi = ui;
+        s.wallLive = live;
         s.wallPitch = pitch;
         s.wallBright = bright;
         close();
@@ -133,6 +141,8 @@ magick "$1[0]" -resize "$3" -quality 90 "$2/.$b.jpg" 2>/dev/null && mv "$2/.$b.j
             else if (e.key === Qt.Key_Backtab) root.look = (root.look + 2) % 3;
             else if ((up || down) && e.modifiers & Qt.ShiftModifier) root.bright = Math.max(10, Math.min(100, root.bright + (up ? 5 : -5)));
             else if (up || down) root.pitch = Math.max(4, Math.min(32, root.pitch + (up ? 1 : -1)));
+            else if (e.key === Qt.Key_U) root.ui = 1 - root.ui;
+            else if (e.key === Qt.Key_A) root.live = !root.live;
             else if (e.key === Qt.Key_Return || e.key === Qt.Key_Enter) root.apply();
             else if (e.key === Qt.Key_Escape) root.close();
             else return;
@@ -215,6 +225,16 @@ magick "$1[0]" -resize "$3" -quality 90 "$2/.$b.jpg" 2>/dev/null && mv "$2/.$b.j
             y: 110
             spacing: 30
             Pick { label: "look"; opts: root.looks; cur: root.look; onPicked: i => root.look = i }
+            Pick { anchors.right: parent.right; label: "home"; opts: ["default", "clear"]; cur: root.ui; onPicked: i => root.ui = i } // noah
+            Pick { // noah: only for wallpapers that ship an animated scene; it plays in the colour look
+                anchors.right: parent.right
+                visible: root.hasScene
+                opacity: root.look === 2 ? 1 : 0.4
+                label: "motion"
+                opts: ["still", "live"]
+                cur: root.live ? 1 : 0
+                onPicked: i => root.live = i === 1
+            }
             Row {
                 anchors.right: parent.right
                 spacing: 36
@@ -288,6 +308,8 @@ magick "$1[0]" -resize "$3" -quality 90 "$2/.$b.jpg" 2>/dev/null && mv "$2/.$b.j
             Lb { text: "tab look" }
             Lb { text: "↑↓ dot size" }
             Lb { text: "shift ↑↓ light" }
+            Lb { text: "u home" }
+            Lb { visible: root.hasScene; text: "a motion" }
             Lb { text: "↵ set" }
             Lb { text: "esc back"; TapHandler { onTapped: root.close() } }
         }
-- 
2.55.0

