             property bool wallLive: true   // noah: a wallpaper folder's scene/Scene.qml plays over it (look: color)
             property string vpnLast: "warp" // noah: vpn/ ring brings back the last tunnel used: warp | proton
             property bool trayOpen: false  // noah: bar's apps part expanded — tray icons of background apps (Slack, Discord…) shown above its arrow
+            property bool audioAuto: true  // noah: a newly plugged/connected audio device becomes the default (Sys.devSettle)
             property bool clipRaw: false   // noah: clip/ image preview in original colours instead of dots (Ctrl+O / click)
         }
     }
diff --git a/config/quickshell/glyph/quick/Quick.qml b/config/quickshell/glyph/quick/Quick.qml
index ce41cf6..33a04e2 100644
--- a/config/quickshell/glyph/quick/Quick.qml
+++ b/config/quickshell/glyph/quick/Quick.qml
@@ -30,6 +30,7 @@ PanelWindow {
         open = true;
     }
     // открытый список: "wifi" | "bt" — под пилюлями (Picker), "rec" — под плитками (Rec), "" — ничего
+    // noah: "in" — inputs under the tiles, "out" — outputs under the volume slider (Sound)
     property string pick: ""
     onOpenChanged: if (open) Sys.earRun([]); else pick = ""
     // курсор 500мс вне панели и полосы Hot — закрываем. seen: Hyprland не отдаёт курсор свежей поверхности, пока мышь не сдвинется —
@@ -193,16 +194,18 @@ PanelWindow {
                         Tile { icon: "\u{F0594}"; name: "night"; on: Sys.night; onClicked: Sys.toggleNight() }
                         Tile { icon: "\u{F001D}"; name: "airplane"; on: Sys.air; onClicked: Sys.toggleAir() }
                         Tile { icon: "\u{F0176}"; name: "caffeine"; on: Sys.caffeine; onClicked: Sys.caffeine = !Sys.caffeine }
-                        Tile { icon: on ? "\u{F036C}" : "\u{F036D}"; name: "mic"; on: Sys.micOn; onClicked: Sys.toggleMic() }
+                        Tile { icon: on ? "\u{F036C}" : "\u{F036D}"; name: "mic"; on: Sys.micOn; picked: root.pick === "in"; onClicked: Sys.toggleMic(); onMenu: root.pick = picked ? "" : "in" }
                         Tile { icon: "\u{F044A}"; name: "record"; on: Sys.rec; picked: root.pick === "rec"; onClicked: { root.close(); Sys.toggleRec(); } onMenu: root.pick = picked ? "" : "rec" }
                         Tile { icon: "\u{F0483}"; name: "vpn"; on: Sys.vpn; onClicked: Sys.toggleVpn() }
                         Tile { icon: "\u{F050E}"; name: "dark"; on: !Theme.light; onClicked: Theme.state.light = !Theme.state.light }
                     }
 
                     Rec { width: parent.width; visible: root.pick === "rec"; onTouched: root.pin(); onStart: { root.close(); Sys.toggleRec(); } }
+                    Sound { width: parent.width; kind: root.pick === "in" ? "in" : ""; onTouched: root.pin() }
 
                     Slider { icon: "\u{F00E0}"; visible: Sys.hasBri; value: Sys.bri; onMoved: v => Sys.setBri(v) }
-                    Slider { icon: Sys.muted ? "\u{F075F}" : "\u{F057E}"; value: Sys.muted ? 0 : Sys.vol; onMoved: v => Sys.setVol(v) }
+                    Slider { icon: Sys.muted ? "\u{F075F}" : "\u{F057E}"; value: Sys.muted ? 0 : Sys.vol; onMoved: v => Sys.setVol(v); onMenu: root.pick = root.pick === "out" ? "" : "out" }
+                    Sound { width: parent.width; kind: root.pick === "out" ? "out" : ""; onTouched: root.pin() }
 
                     // режим питания, как в caelestia: четыре клетки, белая заливка переезжает к выбранной; засечки — сила.
                     // ultra — ещё 60 Гц и без анимаций, blur и теней (Rules.modes)
@@ -472,12 +475,14 @@ PanelWindow {
         Lb { anchors.horizontalCenter: parent.horizontalCenter; text: tile.name; px: 10; color: tile.picked ? Theme.fg : Theme.grey }
     }
     // слайдер: залитая часть — белая пилюля с иконкой, пустая — ряд точек
+    // noah: right click — menu (the volume slider's: list of outputs)
     component Slider: Rectangle {
         id: sl
         property real value
         property string icon
         signal moved(real v)
-        readonly property real shown: area.pressed ? area.v : value
+        signal menu
+        readonly property real shown: area.pressedButtons & Qt.LeftButton ? area.v : value
         width: col.width
         height: 54
         radius: 27
@@ -512,9 +517,10 @@ PanelWindow {
             property real v
             anchors.fill: parent
             preventStealing: true
+            acceptedButtons: Qt.LeftButton | Qt.RightButton
             function set(x) { v = Math.max(0, Math.min(1, x / width)); sl.moved(v); }
-            onPressed: e => { root.pin(); set(e.x); }
-            onPositionChanged: e => set(e.x)
+            onPressed: e => { root.pin(); if (e.button === Qt.RightButton) sl.menu(); else set(e.x); }
+            onPositionChanged: e => { if (pressedButtons & Qt.LeftButton) set(e.x); }
         }
     }
 }
diff --git a/config/quickshell/glyph/quick/Sound.qml b/config/quickshell/glyph/quick/Sound.qml
new file mode 100644
index 0000000..06b0e45
--- /dev/null
+++ b/config/quickshell/glyph/quick/Sound.qml
@@ -0,0 +1,99 @@
+import QtQuick
+import Quickshell.Services.Pipewire
+import qs
+import qs.components
+
+// noah: audio devices, like Picker: outputs under the volume slider (right click on it), inputs under the tiles (right click
+// on mic). Click — that one becomes the default. "auto" in the header: a newly plugged/connected device takes over (Sys.devSettle)
+Rectangle {
+    id: root
+    property string kind // "out" | "in" | "" — closed
+    signal touched       // any click inside — the panel is pinned
+
+    readonly property bool isOut: kind === "out"
+    readonly property var cur: isOut ? Pipewire.defaultAudioSink : Pipewire.defaultAudioSource
+    // the default on top, then by name
+    readonly property var rows: (isOut ? Sys.outs : Sys.ins).slice()
+        .sort((a, b) => (b === cur) - (a === cur) || root.label(a).localeCompare(root.label(b)))
+
+    function label(n) { return n.description || n.nickname || n.name; }
+    function where(n) {
+        return /^bluez_/.test(n.name) ? "bluetooth" : /usb/i.test(n.name) ? "usb" : /hdmi|displayport/i.test(n.name) ? "hdmi"
+            : /^alsa_/.test(n.name) ? "built-in" : "virtual";
+    }
+    function icon(n) {
+        const w = where(n);
+        if (!isOut) return w === "bluetooth" ? "\u{F02CB}" : "\u{F036C}";
+        return w === "bluetooth" || /head/i.test(n.name) ? "\u{F02CB}" : w === "hdmi" ? "\u{F0379}" : "\u{F04C3}";
+    }
+
+    visible: kind === "out" || kind === "in"
+    height: list.height + 32
+    radius: 30
+    color: Theme.s2
+
+    Column {
+        id: list
+        x: 16
+        y: 16
+        width: parent.width - 32
+        spacing: 4
+
+        Item {
+            width: parent.width
+            height: 24
+            Lb { x: 4; anchors.verticalCenter: parent.verticalCenter; text: `${root.isOut ? "outputs" : "inputs"} · ${root.rows.length}` }
+            Lb {
+                anchors { right: parent.right; verticalCenter: parent.verticalCenter }
+                rightPadding: 4
+                text: `auto · ${Theme.state.audioAuto ? "on" : "off"}`
+                color: Theme.state.audioAuto ? Theme.fg : Theme.grey
+                TapHandler { onTapped: { root.touched(); Theme.state.audioAuto = !Theme.state.audioAuto; } }
+                HoverHandler { cursorShape: Qt.PointingHandCursor }
+            }
+        }
+
+        Repeater {
+            model: root.rows
+            Rectangle {
+                id: row
+                required property var modelData
+                readonly property var o: modelData
+                readonly property bool on: o === root.cur
+                width: list.width
+                height: 56
+                radius: 28
+                color: hov.hovered ? Theme.s3 : "transparent"
+
+                Rectangle {
+                    id: ic
+                    x: 6
+                    anchors.verticalCenter: parent.verticalCenter
+                    width: 44
+                    height: 44
+                    radius: 22
+                    color: row.on ? Theme.fg : Theme.s3
+                    Icon { anchors.centerIn: parent; text: root.icon(row.o); font.pixelSize: 19; color: row.on ? Theme.ink : Theme.fg }
+                }
+                Column {
+                    anchors { left: ic.right; leftMargin: 14; right: parent.right; rightMargin: 16; verticalCenter: parent.verticalCenter }
+                    Text { width: parent.width; elide: Text.ElideRight; text: root.label(row.o); font { family: Theme.ui; pixelSize: 15; weight: Font.DemiBold } color: Theme.fg }
+                    Lb {
+                        px: 10
+                        text: root.where(row.o) + (!row.on ? "" : row.o.audio?.muted ? " · in use · muted" : ` · in use · ${Math.round((row.o.audio?.volume ?? 0) * 100)}%`)
+                    }
+                }
+                HoverHandler { id: hov; cursorShape: Qt.PointingHandCursor }
+                TapHandler { onTapped: { root.touched(); Sys.useDev(row.o); } }
+            }
+        }
+
+        Lb {
+            visible: !root.rows.length
+            x: 4
+            topPadding: 4
+            bottomPadding: 4
+            text: "no devices"
+        }
+    }
+}
-- 
