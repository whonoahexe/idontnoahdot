diff --git a/config/quickshell/glyph/Sys.qml b/config/quickshell/glyph/Sys.qml
index 88445b5..e74f76a 100644
--- a/config/quickshell/glyph/Sys.qml
+++ b/config/quickshell/glyph/Sys.qml
@@ -31,6 +31,57 @@ Singleton {
         sink.audio.muted = false;
         sink.audio.volume = Math.max(0, Math.min(1, v));
     }
+    // noah: devices for quick/Sound (right click on the volume slider / mic tile): real outputs and inputs, not app streams
+    readonly property var outs: Pipewire.nodes.values.filter(n => n.type === PwNodeType.AudioSink)
+    readonly property var ins: Pipewire.nodes.values.filter(n => n.type === PwNodeType.AudioSource)
+    function useDev(n) {
+        if (n.type === PwNodeType.AudioSink) Pipewire.preferredDefaultAudioSink = n;
+        else Pipewire.preferredDefaultAudioSource = n;
+    }
+    // noah: auto (Theme.state.audioAuto): a device that shows up — buds connect, a USB mic or headphones plug in — becomes
+    // the default. A device is its node name minus the profile (alsa_output.usb-X, bluez_output.<addr>), so a profile flip
+    // (buds into headset mode for the mic) isn't new, nor is one back within 5 s. HDMI/DP outputs are never picked on their own
+    // (a monitor without speakers). Arrivals settle for 1.5 s; two of a kind at once — PipeWire restarting, resume — none is
+    // picked, and for 3 s after start or after every device vanished nothing is
+    function devKey(n) { return n.name.replace(/\.[^.]*$/, ""); }
+    property var devSeen: ({})  // key → node class, present now
+    property var devGone: ({})  // key → ms it vanished
+    property var devNew: []     // nodes that showed up, waiting for devSettle
+    property real devQuiet: 0   // until then arrivals only get remembered
+    function devScan() {
+        if (!Pipewire.ready) return;
+        const now = {};
+        for (const n of [...outs, ...ins]) if (/^(alsa|bluez)_/.test(n.name)) now[devKey(n)] = n;
+        const t = Date.now();
+        if (!Object.keys(now).length) devQuiet = t + 3000;
+        for (const k in devSeen) if (!now[k]) devGone[k] = t;
+        for (const k in now) {
+            if (devSeen[k] || t < devQuiet || t - (devGone[k] ?? 0) < 5000) continue;
+            devNew.push(now[k]);
+            devSettle.restart();
+        }
+        devSeen = now;
+    }
+    Timer {
+        id: devSettle
+        interval: 1500
+        onTriggered: {
+            const fresh = root.devNew.filter(n => root.devSeen[root.devKey(n)] === n);
+            root.devNew = [];
+            if (!Theme.state.audioAuto) return;
+            for (const type of [PwNodeType.AudioSink, PwNodeType.AudioSource]) {
+                const one = fresh.filter(n => n.type === type);
+                if (one.length !== 1 || /hdmi|iec958|displayport/i.test(one[0].name)) continue;
+                root.useDev(one[0]);
+                Quickshell.execDetached(["notify-send", "-a", "sound", "-e", type === PwNodeType.AudioSink ? "Output" : "Input",
+                    one[0].description || one[0].nickname || one[0].name]);
+            }
+        }
+    }
+    Connections { target: Pipewire.nodes; function onValuesChanged() { root.devScan(); } }
+    Connections { target: Pipewire; function onReadyChanged() { root.devQuiet = Date.now() + 3000; root.devScan(); } }
+    Component.onCompleted: { devQuiet = Date.now() + 3000; devScan(); }
+
     // микрофон кто-то слушает — центр знака в баре краснеет
     PwNodeLinkTracker { id: micUse; node: root.mic }
     readonly property bool live: rec || micUse.linkGroups.length > 0
diff --git a/config/quickshell/glyph/Theme.qml b/config/quickshell/glyph/Theme.qml
index 99f9be5..e3dcfca 100644
--- a/config/quickshell/glyph/Theme.qml
