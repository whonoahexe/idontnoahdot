[Unit]
Description=linux-wallpaperengine
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/opt/linux-wallpaperengine
ExecStart=/usr/bin/linux-wallpaperengine --screen-root DP-1 --bg /home/noah/.local/share/Steam/steamapps/workshop/content/431960/2515923492 --silent --no-audio-processing --fps 30 --scaling fill --assets-dir /home/noah/.local/share/Steam/steamapps/common/wallpaper_engine/assets
Restart=on-failure
RestartSec=2
StartLimitIntervalSec=60
StartLimitBurst=10

[Install]
WantedBy=graphical-session.target
