diff --git a/modules/ii/bar/ClaudeUsage.qml b/modules/ii/bar/ClaudeUsage.qml
new file mode 100644
index 0000000..98b3c41
--- /dev/null
+++ b/modules/ii/bar/ClaudeUsage.qml
@@ -0,0 +1,145 @@
+import QtQuick
+import QtQuick.Layouts
+import Quickshell.Io
+import qs.modules.common
+import qs.modules.common.widgets
+import qs.services
+
+// Anthropic API spend from ~/.local/bin/claude-usage (local records only, no network).
+MouseArea {
+    id: root
+
+    property bool vertical: false
+    property var usage: null
+    readonly property real monthCost: usage?.month?.cost ?? 0
+    readonly property real budget: usage?.monthly_budget ?? 0
+    readonly property bool overBudget: budget > 0 && monthCost >= budget
+
+    implicitWidth: vertical ? 36 : usageRow.implicitWidth + 12
+    implicitHeight: vertical ? usageRow.implicitHeight + 6 : 32
+
+    hoverEnabled: !Config.options.bar.tooltips.clickToShow
+    onClicked: usageProc.running = true
+
+    function formatCost(cost) {
+        const value = Math.max(0, Number(cost) || 0)
+        if (value >= 100) return `$${value.toFixed(0)}`
+        if (value >= 1) return `$${value.toFixed(2)}`
+        return `$${value.toFixed(value >= 0.1 ? 2 : 3)}`
+    }
+
+    function formatTokens(count) {
+        const value = Number(count) || 0
+        if (value >= 1e6) return `${(value / 1e6).toFixed(1)}M`
+        if (value >= 1e3) return `${(value / 1e3).toFixed(1)}k`
+        return `${value}`
+    }
+
+    Process {
+        id: usageProc
+        running: true
+        command: ["bash", "-c", "\"$HOME/.local/bin/claude-usage\" --json"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                try {
+                    root.usage = JSON.parse(text)
+                } catch (e) {
+                    root.usage = null
+                }
+            }
+        }
+    }
+
+    Timer {
+        interval: 60000
+        repeat: true
+        running: true
+        onTriggered: usageProc.running = true
+    }
+
+    RowLayout {
+        id: usageRow
+        anchors.centerIn: parent
+        spacing: 3
+
+        MaterialSymbol {
+            text: "toll"
+            iconSize: Appearance.font.pixelSize.normal
+            color: root.overBudget ? Appearance.colors.colError : Appearance.colors.colPrimary
+        }
+
+        StyledText {
+            visible: !root.vertical
+            text: root.usage ? root.formatCost(root.monthCost) : "–"
+            color: root.overBudget ? Appearance.colors.colError : Appearance.colors.colOnLayer1
+            font.pixelSize: Appearance.font.pixelSize.smaller
+            font.weight: Font.Medium
+            font.features: { "tnum": 1 }
+        }
+    }
+
+    StyledPopup {
+        hoverTarget: root
+
+        ColumnLayout {
+            implicitWidth: 280
+            spacing: 6
+
+            StyledText {
+                text: Translation.tr("Anthropic API spend (estimated)")
+                font.pixelSize: Appearance.font.pixelSize.normal
+                font.weight: Font.Medium
+                color: Appearance.colors.colOnSurfaceVariant
+            }
+
+            StyledPopupValueRow {
+                Layout.fillWidth: true
+                icon: "today"
+                label: Translation.tr("Today")
+                value: `${root.formatCost(root.usage?.today?.cost)} · ${root.usage?.today?.calls ?? 0} calls`
+            }
+            StyledPopupValueRow {
+                Layout.fillWidth: true
+                icon: "calendar_month"
+                label: Translation.tr("This month")
+                value: `${root.formatCost(root.monthCost)}${root.budget > 0 ? " / " + root.formatCost(root.budget) : ""} · ${root.usage?.month?.calls ?? 0} calls`
+            }
+            StyledPopupValueRow {
+                Layout.fillWidth: true
+                icon: "functions"
+                label: Translation.tr("All time")
+                value: `${root.formatCost(root.usage?.all?.cost)} · ${root.usage?.all?.calls ?? 0} calls`
+            }
+            StyledPopupValueRow {
+                Layout.fillWidth: true
+                icon: "data_usage"
+                label: Translation.tr("Month tokens")
+                value: `in ${root.formatTokens((root.usage?.month?.input ?? 0) + (root.usage?.month?.cache_write ?? 0) + (root.usage?.month?.cache_read ?? 0))} · out ${root.formatTokens(root.usage?.month?.output)}`
+            }
+            StyledPopupValueRow {
+                Layout.fillWidth: true
+                icon: "cached"
+                label: Translation.tr("Cache read / write")
+                value: `${root.formatTokens(root.usage?.month?.cache_read)} / ${root.formatTokens(root.usage?.month?.cache_write)}`
+            }
+            StyledPopupValueRow {
+                Layout.fillWidth: true
+                icon: "schedule"
+                label: Translation.tr("Last call")
+                value: root.usage?.last_call ? root.usage.last_call.replace("T", " ").slice(0, 16) : Translation.tr("never")
+            }
+            StyledText {
+                visible: (root.usage?.unpriced_models?.length ?? 0) > 0
+                text: Translation.tr("No price for: ") + (root.usage?.unpriced_models ?? []).join(", ")
+                color: Appearance.colors.colError
+                font.pixelSize: Appearance.font.pixelSize.smallest
+            }
+            StyledText {
+                text: root.usage ? Translation.tr("Local records only · click to refresh") : Translation.tr("claude-usage failed to run")
+                color: Appearance.colors.colOnSurfaceVariant
+                opacity: 0.6
+                font.pixelSize: Appearance.font.pixelSize.smallest
+            }
+        }
+    }
+}
