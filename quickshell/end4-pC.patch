 import qs.modules.common.widgets
 import qs.services
 import QtQuick
@@ -8,9 +9,57 @@ import Quickshell
 StyledListView { // Scrollable window
     id: root
     property bool popup: false
+    // Which screen edge popups slide in from: -1 = left, 1 = right, 0 = no slide (centered positions)
+    property int slideFromSide: 0
+    readonly property bool slidePopup: root.popup && root.slideFromSide !== 0
 
     spacing: 3
 
+    // Popups are anchored to a screen edge, so they should enter from it rather than
+    // materialising in place. Non-popup lists keep StyledListView's fade+pop.
+    add: Transition {
+        animations: root.slidePopup ? [
+            Appearance.animation.sidebarSlideEnter.numberAnimation.createObject(this, {
