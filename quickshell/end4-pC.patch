@@ -7,6 +7,8 @@
 # "$file.tmp" the callers used before) and validated before the original is
 # replaced. Concurrent invocations can no longer move a half-written temp over
 # the config, which is how config.json used to end up empty.
+# Validation needs a JSON object: `jq empty` alone passes on an empty file, so a
+# failed jq upstream (e.g. merging an empty preset) used to empty the config.
 config_json_replace() {
     local file="$1"
     [ -f "$file" ] || return 1
@@ -14,7 +16,7 @@ config_json_replace() {
     local tmp
     tmp="$(mktemp "${file}.XXXXXX")" || return 1
 
-    if cat > "$tmp" && jq empty "$tmp" >/dev/null 2>&1; then
+    if cat > "$tmp" && jq -e 'type == "object"' "$tmp" >/dev/null 2>&1; then
         mv "$tmp" "$file"
     else
         rm -f "$tmp"
@@ -34,7 +36,7 @@ config_json_update() {
     local tmp
     tmp="$(mktemp "${file}.XXXXXX")" || return 1
 
-    if jq "$@" "$file" > "$tmp" 2>/dev/null && jq empty "$tmp" >/dev/null 2>&1; then
+    if jq "$@" "$file" > "$tmp" 2>/dev/null && jq -e 'type == "object"' "$tmp" >/dev/null 2>&1; then
         mv "$tmp" "$file"
     else
         rm -f "$tmp"
