@@ -0,0 +1,23 @@
+import QtQuick
+import Quickshell
+import qs.modules.common
+import qs.services
+
+QuickToggleModel {
+    id: root
+
+    name: Translation.tr("Animated wallpaper")
+    // On = the wallpaper's scene/Scene.qml layer is loaded (Background.qml);
+    // it still freezes by itself on battery and behind tiled/fullscreen windows
+    statusText: !LiveWallpaper.sceneAvailable ? Translation.tr("No scene")
+        : !LiveWallpaper.sceneEnabled ? Translation.tr("Still image")
+        : LiveWallpaper.scenePausedForPower ? Translation.tr("Paused on battery")
+        : Translation.tr("On")
+    icon: "animation"
+    available: LiveWallpaper.sceneAvailable
+    toggled: LiveWallpaper.sceneEnabled
+
+    mainAction: () => LiveWallpaper.setSceneEnabled(!LiveWallpaper.sceneEnabled)
+
+    tooltipText: Translation.tr("Animate the wallpaper's scene. Pauses on battery and behind windows")
+}
