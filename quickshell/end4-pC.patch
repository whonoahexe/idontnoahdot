diff --git a/modules/common/models/quickToggles/LeftShiftToggle.qml b/modules/common/models/quickToggles/LeftShiftToggle.qml
new file mode 100644
index 0000000..ce045d6
--- /dev/null
+++ b/modules/common/models/quickToggles/LeftShiftToggle.qml
@@ -0,0 +1,31 @@
+import QtQuick
+import Quickshell
+import qs.modules.common
+import qs.modules.common.functions
+import qs.modules.common.models.hyprland
+import qs.services
+
+QuickToggleModel {
+    id: root
+    readonly property string keymapPath: FileUtils.trimFileProtocol(`${Directories.config}/xkb/no-left-shift.xkb`)
+
+    name: Translation.tr("Left Shift")
+    // On = left shift works; off = the no-left-shift keymap is loaded
+    toggled: !(confOpt.value && confOpt.value.length > 0 && confOpt.value !== "[[EMPTY]]")
+    icon: "shift"
+
+    mainAction: () => {
+        root.toggled = !root.toggled;
+        if (root.toggled)
+            HyprlandConfig.reset("input:kb_file");
+        else
+            HyprlandConfig.set("input:kb_file", root.keymapPath);
+    }
+
+    HyprlandConfigOption {
+        id: confOpt
+        key: "input:kb_file"
+    }
+
+    tooltipText: Translation.tr("Left Shift key")
+}
diff --git a/modules/common/models/quickToggles/MovieModeToggle.qml b/modules/common/models/quickToggles/MovieModeToggle.qml
new file mode 100644
index 0000000..4df29ef
--- /dev/null
+++ b/modules/common/models/quickToggles/MovieModeToggle.qml
@@ -0,0 +1,59 @@
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import qs.services
+
+QuickToggleModel {
+    id: root
+    property real refreshRate: 0
+    readonly property string flagFile: `${Quickshell.env("HOME")}/.local/state/hypr/movie-mode`
+
+    name: Translation.tr("Movie mode")
+    // On = ~/.local/state/hypr/movie-mode exists; monitors.lua then caps DP-1 at 144 Hz
+    statusText: refreshRate > 0 ? Translation.tr("%1 Hz").arg(Math.round(refreshRate)) : Translation.tr("No ultrawide")
+    icon: "movie"
+
+    mainAction: () => {
+        const flag = `'${root.flagFile}'`;
+        const fileCmd = root.toggled ? `rm -f ${flag}` : `mkdir -p "$(dirname ${flag})" && touch ${flag}`;
+        actionProc.command = ["bash", "-c", `${fileCmd} && hyprctl eval 'hyde_apply_layout()'`];
+        actionProc.running = true;
+    }
+
+    Process {
+        id: actionProc
+        onExited: refreshDelay.restart()
+    }
+
+    // Give Hyprland a moment to finish the modeset before reading it back
+    Timer {
+        id: refreshDelay
+        interval: 1000
+        onTriggered: fetchState.running = true
+    }
+
+    Process {
+        id: fetchState
+        running: true
+        command: ["bash", "-c", `test -e '${root.flagFile}' && echo 1 || echo 0; hyprctl monitors -j | jq -r '.[] | select(.name == "DP-1") | .refreshRate'`]
+        stdout: StdioCollector {
+            id: stateCollector
+            onStreamFinished: {
+                const lines = stateCollector.text.trim().split("\n");
+                root.toggled = lines[0] === "1";
+                root.refreshRate = parseFloat(lines[1]) || 0;
+                root.available = root.refreshRate > 0;
+            }
+        }
+    }
+
+    // Catches the ultrawide being plugged or unplugged
+    Timer {
+        interval: 10000
+        running: true
+        repeat: true
+        onTriggered: fetchState.running = true
+    }
+
+    tooltipText: Translation.tr("Cap the ultrawide at 144 Hz for smooth 24 fps movies")
+}
diff --git a/modules/common/models/quickToggles/ProtonVpnToggle.qml b/modules/common/models/quickToggles/ProtonVpnToggle.qml
new file mode 100644
index 0000000..e3fa937
--- /dev/null
+++ b/modules/common/models/quickToggles/ProtonVpnToggle.qml
@@ -0,0 +1,123 @@
+import QtQuick
+import qs
+import qs.services
+import qs.modules.common
+import qs.modules.common.functions
+import qs.modules.common.widgets
+import Quickshell
+import Quickshell.Io
+
+QuickToggleModel {
+    id: root
+    // "", "connected", "connecting", "disconnected", "missing"
+    property string state: ""
+    // NM connection id = Proton server name, e.g. "NL-FREE#12"
+    property string server: ""
+    readonly property string countryCode: server.split(/[-#]/)[0]
+
+    readonly property var countryNames: ({
+        "US": "United States", "CA": "Canada", "MX": "Mexico", "NL": "Netherlands",
+        "CH": "Switzerland", "NO": "Norway", "PL": "Poland", "RO": "Romania",
+        "JP": "Japan", "SG": "Singapore", "UK": "United Kingdom", "GB": "United Kingdom",
+        "DE": "Germany", "FR": "France", "SE": "Sweden", "IT": "Italy", "ES": "Spain"
+    })
+
+    name: Translation.tr("Proton VPN")
+    icon: "vpn_lock"
+
+    available: state !== "missing" && state !== ""
+    toggled: state === "connected" || state === "connecting"
+    statusText: {
+        switch (state) {
+            case "connected": return countryNames[countryCode] ?? server;
+            case "connecting": return Translation.tr("Connecting…");
+            case "disconnected": return Translation.tr("Right-click: pick country");
+            case "missing": return Translation.tr("Not installed");
+            default: return "";
+        }
+    }
+
+    function notifyFailure(message, output) {
+        Quickshell.execDetached(["notify-send",
+            Translation.tr("Proton VPN"),
+            `${message}\n${output.trim()}`,
+            "-a", "Shell"
+        ])
+    }
+
+    // Two VPNs at once fight over routes and DNS
+    function disconnectWarp() {
+        Quickshell.execDetached(["bash", "-c", "command -v warp-cli >/dev/null && warp-cli --accept-tos disconnect"])
+    }
+
+    function openApp() {
+        root.disconnectWarp()
+        Quickshell.execDetached(["protonvpn-app"])
+        GlobalStates.sidebarRightOpen = false
+    }
+
+    // The CLI only lets free accounts connect to the fastest server, so
+    // picking a country goes through the GUI app
+    mainAction: () => {
+        if (root.toggled) {
+            actionProc.command = ["protonvpn", "disconnect"]
+        } else {
+            root.disconnectWarp()
+            actionProc.command = ["protonvpn", "connect"]
+            root.state = "connecting"
+        }
+        actionProc.running = true
+    }
+    altAction: () => root.openApp()
+
+    Process {
+        id: actionProc
+        stdout: StdioCollector { id: actionCollector }
+        stderr: StdioCollector { id: actionErrCollector }
+        onExited: (exitCode, exitStatus) => {
+            const output = actionCollector.text + actionErrCollector.text
+            if (output.includes("sign in") || output.includes("signin") || output.includes("Authentication"))
+                root.notifyFailure(Translation.tr("Not signed in. Right-click the toggle to sign in."), "")
+            else if (exitCode !== 0)
+                root.notifyFailure(Translation.tr("Command failed:"), output)
+            fetchActiveState.running = true
+        }
+    }
+
+    Process {
+        id: fetchActiveState
+        running: true
+        command: ["bash", "-c", "command -v protonvpn >/dev/null || { echo MISSING; exit; }; "
+            + "[ -e /sys/class/net/proton0 ] || { echo DOWN; exit; }; "
+            + "nmcli -t -g GENERAL.STATE,GENERAL.CONNECTION device show proton0"]
+        stdout: StdioCollector {
+            id: statusCollector
+            onStreamFinished: {
+                const lines = statusCollector.text.trim().split("\n")
+                const wasConnected = root.state === "connected"
+                if (lines[0] === "MISSING") {
+                    root.state = "missing"
+                } else if (lines[0].startsWith("100")) {
+                    root.state = "connected"
+                    root.server = lines[1] ?? ""
+                    // Also covers connecting from the Proton app itself
+                    if (!wasConnected) root.disconnectWarp()
+                } else if (lines[0] !== "DOWN" && /^[4-9]0/.test(lines[0])) {
+                    root.state = "connecting"
+                } else if (!actionProc.running) {
+                    root.state = "disconnected"
+                }
+            }
+        }
+    }
+
+    // Keep the icon honest when the Proton app connects/disconnects
+    Timer {
+        interval: 3000
+        running: true
+        repeat: true
+        onTriggered: fetchActiveState.running = true
+    }
+
+    tooltipText: Translation.tr("Proton VPN | Right-click to pick a country")
+}
