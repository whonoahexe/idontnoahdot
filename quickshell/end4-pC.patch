@@ -59,6 +59,29 @@ Variants {
 
         property bool wallpaperIsVideo: bgRoot.effectiveWallpaperPath.endsWith(".mp4") || bgRoot.effectiveWallpaperPath.endsWith(".webm") || bgRoot.effectiveWallpaperPath.endsWith(".mkv") || bgRoot.effectiveWallpaperPath.endsWith(".avi") || bgRoot.effectiveWallpaperPath.endsWith(".mov")
         property string wallpaperPath: wallpaperIsVideo ? Config.options.background.thumbnailPath : bgRoot.effectiveWallpaperPath
+        // A wallpaper can ship an animated layer as scene/Scene.qml in its folder
+        readonly property string sceneQmlPath: (wallpaperIsVideo || wallpaperPath === "") ? ""
+            : `${wallpaperPath.substring(0, wallpaperPath.lastIndexOf("/"))}/scene/Scene.qml`
+        property bool sceneAvailable: false
+        onSceneAvailableChanged: LiveWallpaper.sceneAvailable = sceneAvailable
+        // A tiled or fullscreen window on this monitor's active workspace hides
+        // nearly all of the wallpaper, so the scene freezes on its current frame
+        readonly property bool sceneCovered: {
+            const wsId = bgRoot.monitor?.activeWorkspace?.id;
+            if (wsId === undefined) return false;
+            return HyprlandData.windowList.some(win => win.workspace?.id === wsId
+                && win.mapped !== false && !win.hidden && (!win.floating || win.fullscreen > 0));
+        }
+        readonly property bool sceneAnimating: !bgRoot.hiddenForFullscreen
+            && !LiveWallpaper.scenePausedForPower
+            && !(bgRoot.sceneCovered && Config.options.background.liveWallpaper.pauseWhenCovered)
+        FileView {
+            path: bgRoot.sceneQmlPath
