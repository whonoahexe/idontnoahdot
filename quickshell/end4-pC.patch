+                "property": "opacity",
+                "from": 0,
+                "to": 1,
+            }),
+        ] : root.animateAppearance ? [
+            Appearance.animation.elementMove.numberAnimation.createObject(this, {
+                "properties": root.popin ? "opacity,scale" : "opacity",
+                "from": 0,
+                "to": 1,
+            }),
