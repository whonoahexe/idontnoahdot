diff --git a/modules/common/models/quickToggles/BatteryOneshotToggle.qml b/modules/common/models/quickToggles/BatteryOneshotToggle.qml
new file mode 100644
index 0000000..b505060
--- /dev/null
+++ b/modules/common/models/quickToggles/BatteryOneshotToggle.qml
@@ -0,0 +1,54 @@
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import qs.services
+
+QuickToggleModel {
+    id: root
+    property int currentLimit: 0
+    property int baseLimit: 0
+
+    name: Translation.tr("Full charge")
+    // On = asusd one-shot active (current limit raised above the saved base limit)
+    toggled: currentLimit > baseLimit && baseLimit > 0
+    statusText: toggled ? Translation.tr("Charging to %1%").arg(currentLimit) : Translation.tr("Limit %1%").arg(baseLimit)
+    icon: "battery_charging_full"
+
+    mainAction: () => {
+        if (root.toggled)
+            actionProc.command = ["asusctl", "battery", "limit", `${root.baseLimit}`];
+        else
+            actionProc.command = ["asusctl", "battery", "oneshot"];
+        actionProc.running = true;
+    }
+
+    Process {
+        id: actionProc
+        onExited: fetchState.running = true
+    }
+
+    Process {
+        id: fetchState
+        running: true
+        command: ["bash", "-c", "cat /sys/class/power_supply/BAT*/charge_control_end_threshold | head -1; grep -oP 'base_charge_control_end_threshold:\\s*\\K\\d+' /etc/asusd/asusd.ron"]
+        stdout: StdioCollector {
+            id: stateCollector
+            onStreamFinished: {
+                const lines = stateCollector.text.trim().split("\n");
+                root.currentLimit = parseInt(lines[0]) || 0;
+                root.baseLimit = parseInt(lines[1]) || 0;
+                root.available = root.currentLimit > 0;
+            }
+        }
+    }
+
+    // asusd drops back to the base limit on its own once the battery is full
+    Timer {
+        interval: 30000
+        running: true
+        repeat: true
+        onTriggered: fetchState.running = true
+    }
+
+    tooltipText: Translation.tr("One-shot charge to 100% (asusctl)")
+}
