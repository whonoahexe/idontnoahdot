#!/usr/bin/env bash
# Rebuild Strata from the newest stable release with the local patches on top.
# Patches live as commits on branch local/ssh-hosts in ~/.local/src/strata.
# Usage: strata-patched-update [--force|--check]   (--force rebuilds even when up to date;
#        --check only checks that the Glyph styling still fits the current source)
set -euo pipefail

SRC="$HOME/.local/src/strata"
BRANCH="local/ssh-hosts"
BIN="$HOME/.local/bin/strata"

notify() { notify-send -a Strata -i io.github.lgse.Strata "Strata update" "$1" 2>/dev/null || true; echo "$1"; }

# Glyph styles Strata from outside: a theme in ~/.config/strata/themes/glyph.toml and Strata-only rules at the end of
# Glyph's gtk-4.0/gtk.css. Neither is touched by an update, but a release can rename a CSS class or add a required
# theme key, and then the styling silently drops. Prints what no longer matches; empty when all fits (or no Glyph)
glyph_drift() {
    local css="$HOME/.local/share/glyph/config/quickshell/glyph/term/gtk-4.0/gtk.css"
    local theme="$HOME/.config/strata/themes/glyph.toml"
    [[ -f $css ]] || return 0
    python3 - "$css" "$theme" "$SRC" <<'EOF'
import pathlib, re, sys, tomllib
css, theme, src = sys.argv[1], pathlib.Path(sys.argv[2]), pathlib.Path(sys.argv[3])
text = open(css).read()
text = text[text.find("Strata (file manager)"):]
text = re.sub(r"/\*.*?\*/", "", text, flags=re.S)
selectors = re.sub(r"\{[^}]*\}", " ", text)
classes = sorted(set(re.findall(r"\.([a-z][a-z0-9-]*)", selectors)))
code = "".join(p.read_text(errors="ignore") for p in [*src.joinpath("src").rglob("*.rs"), src / "src/style.css"])
gone = [c for c in classes if not re.search(r"(?<![a-z0-9-])" + re.escape(c) + r"(?![a-z0-9-])", code)]
if gone:
    print("CSS classes gone: " + " ".join(gone))
body = re.search(r"pub struct ThemeTokens \{(.*?)\n\}", (src / "src/ui/theme.rs").read_text(), re.S)
if body and theme.exists():
    required = [m.group(2) for m in re.finditer(r"(#\[serde\(default[^\n]*\n\s*)?pub (\w+): (\w+)", body.group(1))
                if not m.group(1) and m.group(3) != "Option"]
    have = tomllib.loads(theme.read_text())
    missing = [k for k in required if k not in have]
    if missing:
        print("glyph.toml lacks required keys: " + " ".join(missing))
EOF
}

if [[ ${1:-} == --check ]]; then
    cd "$SRC"
    drift=$(glyph_drift)
    echo "${drift:-Glyph styling matches $(git describe --tags --abbrev=0 --match 'v*' HEAD)}"
    [[ -z $drift ]]
    exit
fi

cd "$SRC"
git checkout -q "$BRANCH"
git fetch -q --tags origin
latest=$(git tag -l 'v*' --sort=-v:refname | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | head -1)
current=$(git describe --tags --abbrev=0 --match 'v*' HEAD)

if [[ $latest != "$current" ]] && ! git merge-base --is-ancestor "$latest" HEAD; then
    echo "Rebasing patches from $current onto $latest"
    if ! git rebase -q --onto "$latest" "$current" "$BRANCH"; then
        git rebase --abort
        notify "Strata $latest is out, but the local patches no longer apply. Still on $current; ask Claude to rebase them."
        exit 1
    fi
elif [[ ${1:-} != --force ]]; then
    echo "Up to date ($current with patches)"
    exit 0
fi

tag=$(git describe --tags --abbrev=0 --match 'v*' HEAD)
if ! nice -n 19 cargo build --release --locked; then
    notify "Building patched Strata $tag failed. Still running the previous build."
    exit 1
fi

[[ -f $BIN ]] && cp -p "$BIN" "$BIN.prev"
install -m 755 target/release/strata "$BIN.new"
mv -f "$BIN.new" "$BIN"
drift=$(glyph_drift)
if [[ -n $drift ]]; then
    notify "Patched Strata $tag installed, but the Glyph look no longer fits it ($drift). Ask Claude to update the Glyph styling."
else
    notify "Patched Strata $tag installed. Restart Strata to use it."
fi
