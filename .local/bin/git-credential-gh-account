#!/bin/sh
# git credential helper: hands git the token of the gh account named by
# `git config github.user` (set per-directory via includeIf in ~/.gitconfig).
[ "$1" = get ] || exit 0
user=$(git config --get github.user) || exit 0
token=$(/usr/bin/gh auth token -u "$user" 2>/dev/null) || exit 0
printf 'username=%s\npassword=%s\n' "$user" "$token"
